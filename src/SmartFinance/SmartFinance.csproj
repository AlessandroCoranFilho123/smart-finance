<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartFinance</RootNamespace>
    <AssemblyName>SmartFinance</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.1.0</Version>
    <Authors>Alessandro Coran Filho</Authors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS8602</NoWarn>

    <!-- Publicação: exe único self-contained com compilação antecipada (startup rápido).
         Propriedades afetam somente `dotnet publish` (SelfContained/RID condicionados
         para não interferir em builds comuns de desenvolvimento/CI). -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Referência explícita para usar o bundle 3.x (corrige CVE do bundle 2.1.11 transitivo) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartFinance.Tests" />
    <InternalsVisibleTo Include="SmartFinance.GuiTests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\**\*.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
