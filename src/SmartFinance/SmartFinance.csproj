<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmartFinance</RootNamespace>
    <AssemblyName>SmartFinance</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.3.0</Version>
    <Authors>Alessandro Coran Filho</Authors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Publicação via linha de comando (ver README): dotnet publish com
         -r win-x64, -self-contained true, PublishSingleFile, PublishReadyToRun
         e IncludeNativeLibrariesForSelfExtract. Essas propriedades NÃO ficam no
         csproj: PublishSingleFile no projeto altera o runtimeconfig dos builds
         comuns e quebra o exe de saída. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Referência explícita para usar o bundle 3.x (corrige CVE do bundle 2.1.11 transitivo) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartFinance.Tests" />
    <InternalsVisibleTo Include="SmartFinance.GuiTests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\**\*.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
