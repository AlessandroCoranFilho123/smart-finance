<UserControl x:Class="SmartFinance.Views.CartoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cartão de crédito" Style="{StaticResource TituloView}" />
            <Button Grid.Column="1" Content="+ Nova compra" Style="{StaticResource BotaoPrimario}" Click="NovaCompra" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Total em aberto" Style="{StaticResource TextoSecundario}" />
                    <TextBlock x:Name="TxtAberto" Text="R$ 0,00" FontSize="16" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Parcelas por mês" Style="{StaticResource TextoSecundario}" />
                    <TextBlock x:Name="TxtParcelasMes" Text="R$ 0,00" FontSize="16" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Vencendo em até 7 dias" Style="{StaticResource TextoSecundario}" />
                    <TextBlock x:Name="TxtVencendo" Text="0 compra(s)" FontSize="16" FontWeight="Bold" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="2" x:Name="ListaCompras" Margin="0,16,0,0" MouseDoubleClick="EditarCompra" KeyDown="AoTeclarLista" />

        <TextBlock Grid.Row="3" Margin="4,10,4,0"
                   Text="Duplo clique em uma compra para editar ou excluir"
                   Style="{StaticResource TextoSecundario}" />
    </Grid>
</UserControl>
