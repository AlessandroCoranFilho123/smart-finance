<UserControl x:Class="SmartFinance.Views.TransacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Todas as transações" Style="{StaticResource TituloView}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Exportar .csv" Style="{StaticResource BotaoSecundario}" Click="ExportarCsv" />
                <Button Content="Exportar .txt" Style="{StaticResource BotaoSecundario}" Margin="8,0,0,0" Click="ExportarTxt" />
                <Button Content="+ Nova transação" Style="{StaticResource BotaoPrimario}" Margin="12,0,0,0" Click="NovaTransacao" />
            </StackPanel>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Buscar" Style="{StaticResource RotuloForm}" />
                        <TextBox x:Name="CampoBusca" MinWidth="220"
                                 TextChanged="AoMudarFiltro" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Tipo" Style="{StaticResource RotuloForm}" />
                        <ComboBox x:Name="ComboTipo" MinWidth="130" SelectionChanged="AoMudarFiltro">
                            <ComboBoxItem IsSelected="True" Content="Todos" />
                            <ComboBoxItem Content="Entrada" />
                            <ComboBoxItem Content="Saída" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="Categoria" Style="{StaticResource RotuloForm}" />
                        <ComboBox x:Name="ComboCategoria" MinWidth="160" SelectionChanged="AoMudarFiltro" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="12,0,0,0">
                        <TextBlock Text="De" Style="{StaticResource RotuloForm}" />
                        <DatePicker x:Name="DataInicio" MinWidth="130" SelectedDateChanged="AoMudarFiltro" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="12,0,0,0">
                        <TextBlock Text="Até" Style="{StaticResource RotuloForm}" />
                        <DatePicker x:Name="DataFim" MinWidth="130" SelectedDateChanged="AoMudarFiltro" />
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="12,0,0,0">
                        <TextBlock Text=" " Style="{StaticResource RotuloForm}" />
                        <Button Content="Limpar" Style="{StaticResource BotaoSecundario}" Click="LimparFiltros" />
                    </StackPanel>
                </Grid>

                <!-- Resumo do filtro -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Entradas" Style="{StaticResource TextoSecundario}" />
                        <TextBlock x:Name="TxtEntradas" Text="R$ 0,00" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushEntrada}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Saídas" Style="{StaticResource TextoSecundario}" />
                        <TextBlock x:Name="TxtSaidas" Text="R$ 0,00" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushSaida}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Resultado do filtro" Style="{StaticResource TextoSecundario}" />
                        <TextBlock x:Name="TxtSaldoFiltro" Text="R$ 0,00" FontWeight="SemiBold" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <TextBlock Grid.Row="2" Text="Histórico" Style="{StaticResource TituloSecao}" Margin="2,16,0,8" />
        <ListBox Grid.Row="3" x:Name="ListaTransacoes" MouseDoubleClick="EditarTransacao" KeyDown="AoTeclarLista" />

        <!-- Rodapé -->
        <Grid Grid.Row="4" Margin="4,10,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtTotal" Text="Total: 0 transações" Style="{StaticResource TextoSecundario}" />
            <TextBlock Grid.Column="1" Text="Duplo clique em uma transação para editar" Style="{StaticResource TextoSecundario}" />
        </Grid>
    </Grid>
</UserControl>
