<UserControl x:Class="SmartFinance.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Saldo -->
            <Border Style="{StaticResource Card}" Padding="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Saldo disponível" Style="{StaticResource TextoSecundario}" />
                        <TextBlock x:Name="TxtSaldo" Text="R$ 0,00" FontSize="34" FontWeight="Bold"
                                   Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Receitas do mês" Style="{StaticResource TextoSecundario}" />
                                <TextBlock x:Name="TxtReceitas" Text="R$ 0,00" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushEntrada}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="36,0,0,0">
                                <TextBlock Text="Despesas do mês" Style="{StaticResource TextoSecundario}" />
                                <TextBlock x:Name="TxtDespesas" Text="R$ 0,00" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushSaida}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <Border Background="{DynamicResource BrushAccentSoft}" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccent}" VerticalAlignment="Center" />
                                    <TextBlock Text="Banco" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSaldoBanco" Text="R$ 0,00" FontSize="12" FontWeight="SemiBold"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushEntrada}" VerticalAlignment="Center" />
                                    <TextBlock Text="Dinheiro físico" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSaldoDinheiro" Text="R$ 0,00" FontSize="12" FontWeight="SemiBold"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Carteiras" Style="{StaticResource BotaoSecundario}"
                                    Padding="12,7" Click="AbrirCarteiras" />
                            <Button Content="Transferir" Style="{StaticResource BotaoSecundario}"
                                    Padding="12,7" Margin="8,0,0,0" Click="AbrirTransferencia" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Recentes + metas -->
            <Grid Margin="0,18,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transações recentes" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Ver todas →" Style="{StaticResource BotaoLink}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"
                                        Click="IrParaTransacoes" />
                                <Button Content="+ Nova transação"
                                        Style="{StaticResource BotaoPrimario}" Padding="12,7"
                                        Click="NovaTransacao" />
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="ListaTransacoes" Grid.Row="1" Margin="0,10,0,0"
                                 MinHeight="260" MaxHeight="440"
                                 MouseDoubleClick="EditarTransacao" KeyDown="AoTeclarLista" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Metas" Style="{StaticResource TituloSecao}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="+ Nova meta"
                                    Style="{StaticResource BotaoPrimario}" Padding="12,7"
                                    Click="NovaMeta" />
                        </Grid>

                        <ListBox x:Name="ListaMetas" Grid.Row="1" Margin="0,10,0,0"
                                 MinHeight="260" MaxHeight="440"
                                 MouseDoubleClick="EditarMeta" KeyDown="AoTeclarListaMeta" />
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
