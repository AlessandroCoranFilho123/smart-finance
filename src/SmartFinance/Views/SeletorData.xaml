<UserControl x:Class="SmartFinance.Views.SeletorData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button x:Name="BotaoData"
                Click="AbrirCalendario"
                HorizontalContentAlignment="Left"
                Padding="10,8"
                Cursor="Hand"
                AutomationProperties.Name="Selecionar data">
            <TextBlock x:Name="TextoData" Text="Selecione uma data" />
        </Button>
        <Popup x:Name="PopupCalendario"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=BotaoData}"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushCardBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,4,8,8"
                    Padding="8">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShadow}"
                                      Opacity="{DynamicResource ShadowOpacity}"
                                      BlurRadius="16" ShadowDepth="3" Direction="270" />
                </Border.Effect>
                <Calendar x:Name="Calendario" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
