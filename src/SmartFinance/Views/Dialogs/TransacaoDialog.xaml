<Window x:Class="SmartFinance.Views.Dialogs.TransacaoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova transação"
        Width="520" SizeToContent="Height"
        MaxWidth="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <StackPanel Margin="24">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="8">
                <Image Source="/Assets/icons/transacao.png" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="TxtTitulo" Grid.Column="1" Text="Nova transação" Style="{StaticResource TituloView}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="BotaoEntrada" Style="{StaticResource BotaoAlternar}"
                          Tag="{DynamicResource BrushEntrada}"
                          Content="Entrada" Checked="AoMudarTipo" Unchecked="AoMudarTipo" />
            <ToggleButton x:Name="BotaoSaida" Grid.Column="2" Style="{StaticResource BotaoAlternar}"
                          Tag="{DynamicResource BrushSaida}"
                          Content="Saída" Checked="AoMudarTipo" Unchecked="AoMudarTipo" />
        </Grid>

        <TextBlock Text="Valor" Style="{StaticResource RotuloForm}" Margin="0,16,0,4" />
        <TextBox x:Name="CampoValor" PreviewTextInput="ValidarDigitoValor" LostFocus="FormatarValorAoSair" />

        <TextBlock Text="Data" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <DatePicker x:Name="CampoData" />

        <TextBlock Text="Categoria" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <ComboBox x:Name="ComboCategoria" SelectionChanged="AoMudarCategoria" />

        <TextBlock Text="Carteira" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <ComboBox x:Name="ComboCarteira" DisplayMemberPath="Nome" />

        <StackPanel x:Name="BoxMeta" Visibility="Collapsed">
            <TextBlock Text="Meta" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
            <ComboBox x:Name="ComboMeta" SelectionChanged="AoMudarMeta" DisplayMemberPath="Nome" />
            <TextBlock x:Name="TxtInfoMeta" Style="{StaticResource TextoSecundario}" Margin="2,6,0,0" />
        </StackPanel>

        <TextBlock Text="Comentário" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <TextBox x:Name="CampoComentario" AcceptsReturn="False" Height="64"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

        <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}" Margin="2,12,0,0"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Margin="0,20,0,4">
            <Button x:Name="BotaoExcluir" Content="Excluir" Style="{StaticResource BotaoExcluir}"
                    HorizontalAlignment="Left" Click="Excluir" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource BotaoSecundario}" Click="Cancelar" />
                <Button x:Name="BotaoSalvar" Content="Salvar" Style="{StaticResource BotaoPrimario}"
                        Margin="8,0,0,0" Padding="20,8" IsDefault="True" Click="Salvar" />
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
