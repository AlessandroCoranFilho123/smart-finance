<Window x:Class="SmartFinance.Views.Dialogs.CarteirasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carteiras"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <StackPanel Margin="24">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="8">
                <Image Source="Assets/icons/logo.png" Stretch="Uniform" />
            </Border>
            <TextBlock Grid.Column="1" Text="Carteiras" Style="{StaticResource TituloView}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Margin="0,16,0,0"
                   Text="Ajuste o saldo inicial de cada carteira. O saldo atual soma as transações e transferências."
                   Style="{StaticResource TextoSecundario}" TextWrapping="Wrap" />

        <TextBlock Text="Saldo inicial — Banco" Style="{StaticResource RotuloForm}" Margin="0,18,0,4" />
        <TextBox x:Name="CampoBanco" PreviewTextInput="ValidarDigitoValor" />

        <TextBlock Text="Saldo inicial — Dinheiro físico" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <TextBox x:Name="CampoDinheiro" PreviewTextInput="ValidarDigitoValor" />

        <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}" Margin="2,14,0,0"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,4">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Click="Cancelar" />
            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}"
                    Margin="8,0,0,0" Padding="20,8" IsDefault="True" Click="Salvar" />
        </StackPanel>

    </StackPanel>
</Window>
