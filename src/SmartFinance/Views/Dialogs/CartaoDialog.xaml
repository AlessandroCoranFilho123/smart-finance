<Window x:Class="SmartFinance.Views.Dialogs.CartaoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SmartFinance.Views"
        Title="Nova compra no cartão"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <StackPanel Margin="24">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="8">
                <Image Source="/Assets/icons/credito.png" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="TxtTitulo" Grid.Column="1" Text="Nova compra no cartão" Style="{StaticResource TituloView}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <TextBlock Text="Nome" Style="{StaticResource RotuloForm}" Margin="0,18,0,4" />
        <TextBox x:Name="CampoNome" />

        <TextBlock Text="Valor total" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <TextBox x:Name="CampoValor" PreviewTextInput="ValidarDigitoValor" LostFocus="FormatarAoSair" />

        <TextBlock Text="Meses parcelados" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <TextBox x:Name="CampoParcelas" />

        <TextBlock Text="Parcelas já pagas" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <TextBox x:Name="CampoPagas" />

        <TextBlock Text="Vencimento da próxima parcela" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <views:SeletorData x:Name="CampoVencimento" AutomationProperties.Name="Vencimento da próxima parcela" />

        <TextBlock Text="Carteira" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <ComboBox x:Name="ComboCarteira" DisplayMemberPath="Nome" />

        <TextBlock Style="{StaticResource TextoSecundario}" Margin="2,10,0,0"
                   TextWrapping="Wrap"
                   Text="Salvar gera uma saída do valor total na carteira escolhida (o dinheiro fica comprometido com o cartão)." />

        <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}" Margin="2,14,0,0"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Margin="0,20,0,4">
            <Button x:Name="BotaoExcluir" Content="Excluir" Style="{StaticResource BotaoExcluir}"
                    HorizontalAlignment="Left" Click="Excluir" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource BotaoSecundario}" Click="Cancelar" />
                <Button x:Name="BotaoSalvar" Content="Salvar" Style="{StaticResource BotaoPrimario}"
                        Margin="8,0,0,0" Padding="20,8" IsDefault="True" Click="Salvar" />
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
