<Window x:Class="SmartFinance.Views.Dialogs.EmprestimoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo empréstimo"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBg}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <StackPanel Margin="24">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="8">
                <Image Source="Assets/icons/emprestimo.png" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="TxtTitulo" Grid.Column="1" Text="Novo empréstimo" Style="{StaticResource TituloView}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="BotaoEmprestei" Style="{StaticResource BotaoAlternar}"
                          Tag="{DynamicResource BrushEntrada}"
                          Content="Emprestei" Checked="AoMudarTipo" />
            <ToggleButton x:Name="BotaoPedi" Grid.Column="2" Style="{StaticResource BotaoAlternar}"
                          Tag="{DynamicResource BrushAviso}"
                          Content="Pedi emprestado" Checked="AoMudarTipo" />
        </Grid>

        <TextBlock Text="Nome" Style="{StaticResource RotuloForm}" Margin="0,16,0,4" />
        <TextBox x:Name="CampoNome" />

        <TextBlock Text="Valor" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <TextBox x:Name="CampoValor" PreviewTextInput="ValidarDigitoValor" />

        <TextBlock Text="Data de pagamento" Style="{StaticResource RotuloForm}" Margin="0,14,0,4" />
        <DatePicker x:Name="CampoData" />

        <TextBlock x:Name="TxtErro" Style="{StaticResource TextoErro}" Margin="2,14,0,0"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Margin="0,20,0,4">
            <Button x:Name="BotaoExcluir" Content="Excluir" Style="{StaticResource BotaoExcluir}"
                    HorizontalAlignment="Left" Click="Excluir" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Click="Cancelar" />
                <Button x:Name="BotaoSalvar" Content="Salvar" Style="{StaticResource BotaoPrimario}"
                        Margin="8,0,0,0" Padding="20,8" IsDefault="True" Click="Salvar" />
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
