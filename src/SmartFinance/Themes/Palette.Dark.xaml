<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Paleta escura -->
    <Color x:Key="ColorAccent">#6C8CFF</Color>
    <Color x:Key="ColorShadow">#000000</Color>

    <SolidColorBrush x:Key="BrushBg" Color="#0F131C" />
    <SolidColorBrush x:Key="BrushSidebar" Color="#121724" />
    <SolidColorBrush x:Key="BrushCard" Color="#171D2B" />
    <SolidColorBrush x:Key="BrushCardBorder" Color="#242C3F" />
    <SolidColorBrush x:Key="BrushDivider" Color="#222A3C" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#E9EDF6" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#97A1B8" />
    <SolidColorBrush x:Key="BrushAccent" Color="#6C8CFF" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#5876E8" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#24304F" />
    <SolidColorBrush x:Key="BrushAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushEntrada" Color="#33C98D" />
    <SolidColorBrush x:Key="BrushSaida" Color="#F16A70" />
    <SolidColorBrush x:Key="BrushAviso" Color="#F5B23F" />
    <SolidColorBrush x:Key="BrushErro" Color="#F16A70" />
    <SolidColorBrush x:Key="BrushFieldBg" Color="#1C2434" />
    <SolidColorBrush x:Key="BrushFieldBorder" Color="#2A3448" />
    <SolidColorBrush x:Key="BrushHover" Color="#1E2637" />
    <SolidColorBrush x:Key="BrushTrack" Color="#232B3D" />

    <sys:Double x:Key="ShadowOpacity">0.35</sys:Double>
</ResourceDictionary>
