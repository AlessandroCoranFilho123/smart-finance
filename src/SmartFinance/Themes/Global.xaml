<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Tipografia base ===== -->
    <sys:Double x:Key="FonteNormal">13</sys:Double>
    <sys:Double x:Key="FontePequena">12</sys:Double>
    <sys:Double x:Key="FonteTitulo">20</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontePequena}" />
    </Style>

    <Style x:Key="TituloView" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FonteTitulo}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TituloSecao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="RotuloForm" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontePequena}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <Style x:Key="TextoErro" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushErro}" />
        <Setter Property="FontSize" Value="{StaticResource FontePequena}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Cartões ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ColorShadow}"
                                  Opacity="{DynamicResource ShadowOpacity}"
                                  BlurRadius="18" ShadowDepth="3" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botões ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FonteNormal}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <!-- TextBlock em vez de ContentPresenter: o estilo implícito
                             de TextBlock (SF-025) venceria o Foreground do botão e
                             o texto primário ficaria com a cor errada sobre o accent.
                             Usos deste estilo têm conteúdo sempre primitivo. -->
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource BrushFieldBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                                    <Border x:Name="fundo"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource BrushFieldBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Excluir nos diálogos: mesmo tamanho/linha dos outros botões (visual de
         campo, como BotaoSecundario) com texto vermelho para ação destrutiva.
         Template próprio com TextBlock: herdando o template de BotaoSecundario
         (ContentPresenter), o estilo implícito de TextBlock (SF-025) anularia
         o vermelho e o texto sairia com a cor de texto comum. -->
    <Style x:Key="BotaoExcluir" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
        <Setter Property="Foreground" Value="{DynamicResource BrushSaida}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BrushFieldBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de ação destrutiva/cancelamento: vermelho sólido com texto branco -->
    <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource BrushSaida}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fundo"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <!-- ver nota do TextBlock no BotaoPrimario -->
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fundo" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource BrushAccentTexto}" />
        <Setter Property="FontSize" Value="{StaticResource FontePequena}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Navegação da barra lateral -->
    <!-- SF-025: o estilo implícito de TextBlock fixa Foreground e vence a herança;
         este estilo rebinda ao Foreground do RadioButton (muda no IsChecked). -->
    <Style x:Key="TextoNav" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    </Style>

    <Style x:Key="BotaoNav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="fundo"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="14,11">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alternador Entrada/Saída e Emprestei/Pedi -->
    <Style x:Key="BotaoAlternar" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FonteNormal}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="fundo"
                            Background="{DynamicResource BrushFieldBg}"
                            BorderBrush="{DynamicResource BrushFieldBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="0,10">
                        <!-- ver nota do TextBlock no BotaoPrimario (conteúdo
                             primitivo "Entrada"/"Saída"/"Emprestei"/"Pedi") -->
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fundo" Property="BorderThickness" Value="2" />
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" />
                            <Setter TargetName="fundo" Property="Background" Value="Transparent" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Campos de texto ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource BrushFieldBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushFieldBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FonteNormal}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="fundo"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <!-- Sem Margin=Padding: o TextBoxView interno já aplica o
                             Padding do controle; aplicá-lo aqui também dobraria o
                             espaçamento e deixaria o campo mais alto que os outros
                             (ComboBox/SeletorData) da mesma linha. -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource BrushTextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="fundo" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FonteNormal}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="interruptor"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="fundo"
                                            Background="{DynamicResource BrushFieldBg}"
                                            BorderBrush="{DynamicResource BrushFieldBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="30" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource BrushTextSecondary}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource BrushTextSecondary}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="fundo" Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter Margin="12,8,30,8"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

                        <!-- Placeholder quando nada está selecionado -->
                        <TextBlock Margin="12,8,30,8"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushCardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,4,8,8"
                                    Padding="5"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ColorShadow}"
                                                      Opacity="{DynamicResource ShadowOpacity}"
                                                      BlurRadius="16" ShadowDepth="3" Direction="270" />
                                </Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="fundo" Background="Transparent" CornerRadius="7" Padding="10,8">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Calendário (SeletorData) ===== -->
    <!-- O template padrão do WPF usa texto preto sobre fundo transparente:
         no tema escuro o calendário fica ilegível. O Calendar e o CalendarItem
         recebem estilos implícitos (criados fora de template); os botões de
         dia/mês são criados em código DENTRO da árvore do template do
         CalendarItem, onde estilos implícitos de app não são aplicados — por
         isso entram pelas propriedades CalendarDayButtonStyle/CalendarButtonStyle. -->
    <Style x:Key="BotaoDiaCalendario" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="7" />
                        <!-- TextBlock real (não ContentPresenter): o estilo implícito
                             de TextBlock venceria Foreground herdado/anexado, mas
                             perde para os triggers do template abaixo -->
                        <TextBlock x:Name="texto" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="texto" Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                            <Setter TargetName="texto" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="texto" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                            <Setter TargetName="texto" Property="Foreground" Value="{DynamicResource BrushAccentTexto}" />
                            <Setter TargetName="texto" Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccent}" />
                            <Setter TargetName="texto" Property="Foreground" Value="{DynamicResource BrushAccentForeground}" />
                            <Setter TargetName="texto" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoMesCalendario" TargetType="CalendarButton">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Border x:Name="fundo" Background="Transparent" CornerRadius="7" />
                        <TextBlock x:Name="texto" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                            <Setter TargetName="texto" Property="Foreground" Value="{DynamicResource BrushAccentTexto}" />
                            <Setter TargetName="texto" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource BotaoDiaCalendario}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource BotaoMesCalendario}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <CalendarItem x:Name="PART_CalendarItem"
                                  Style="{DynamicResource {x:Type CalendarItem}}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Foreground="{TemplateBinding Foreground}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold" Margin="2,4"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </DataTemplate>
                        <ControlTemplate x:Key="BotaoSetaAnterior" TargetType="Button">
                            <Border x:Name="fundo" Background="Transparent" CornerRadius="6">
                                <Path Data="M 9 2 L 3 9 L 9 16" StrokeThickness="2"
                                      
                                      Stroke="{DynamicResource BrushTextSecondary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <ControlTemplate x:Key="BotaoSetaProxima" TargetType="Button">
                            <Border x:Name="fundo" Background="Transparent" CornerRadius="6">
                                <Path Data="M 3 2 L 9 9 L 3 16" StrokeThickness="2"
                                      
                                      Stroke="{DynamicResource BrushTextSecondary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                        <ControlTemplate x:Key="BotaoCabecalho" TargetType="Button">
                            <Border x:Name="fundo" Background="Transparent" CornerRadius="6" Padding="10,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource BrushTextPrimary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,2,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Grid.Column="0" Width="28" Height="24"
                                    Focusable="False" Template="{StaticResource BotaoSetaAnterior}" />
                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Height="24"
                                    FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                    Focusable="False" Template="{StaticResource BotaoCabecalho}" />
                            <Button x:Name="PART_NextButton" Grid.Column="2" Width="28" Height="24"
                                    Focusable="False" Template="{StaticResource BotaoSetaProxima}" />
                        </Grid>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="4,2,4,2" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Margin="4,2,4,2" Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- A troca de visão é feita pelo template (como no padrão
                             do WPF): DataTrigger no DisplayMode do Calendar ancestral —
                             o CalendarItem não tem essa propriedade. -->
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===== Listas ===== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="fundo"
                                        Background="Transparent"
                                        CornerRadius="10"
                                        Padding="10,6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="fundo" Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barra de progresso (metas) ===== -->
    <!-- PART_Track/PART_Indicator são os nomes que o ProgressBar usa para
         dimensionar o preenchimento automaticamente. -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Background" Value="{DynamicResource BrushTrack}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barra de rolagem fina ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource BrushTextSecondary}"
                                                    Opacity="0.35" CornerRadius="4" Margin="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ToolTip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BrushCard}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
