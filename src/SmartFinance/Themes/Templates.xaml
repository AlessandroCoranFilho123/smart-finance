<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:linhas="clr-namespace:SmartFinance.Views">

    <!-- ===== Linha de transação ===== -->
    <DataTemplate DataType="{x:Type linhas:LinhaTransacao}">
        <Grid Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="7">
                <Image Source="{Binding Icone}" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TextoSecundario}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding Valor}" VerticalAlignment="Center"
                       Foreground="{Binding CorValor}" FontSize="13" FontWeight="Bold" />
        </Grid>
    </DataTemplate>

    <!-- ===== Linha de meta ===== -->
    <DataTemplate DataType="{x:Type linhas:LinhaMeta}">
        <Grid Margin="4,6,4,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Percentual}" FontSize="12"
                           Foreground="{Binding CorProgresso}" FontWeight="Bold" />
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding TextoValores}" Style="{StaticResource TextoSecundario}"
                       Margin="0,2,0,0" />

            <ProgressBar Grid.Row="2" Value="{Binding Progresso}" Maximum="1" Margin="0,7,0,0"
                         Foreground="{Binding CorProgresso}" />
        </Grid>
    </DataTemplate>

    <!-- ===== Linha de compra no cartão ===== -->
    <DataTemplate DataType="{x:Type linhas:LinhaCompra}">
        <Grid Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="7">
                <Image Source="Assets/icons/credito.png" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detalhe}" Style="{StaticResource TextoSecundario}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding ValorParcela}" FontSize="13" FontWeight="Bold"
                           Foreground="{Binding CorAviso}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Aviso}" FontSize="11"
                           Foreground="{Binding CorAviso}" HorizontalAlignment="Right"
                           Visibility="{Binding AvisoVisivel}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===== Linha de empréstimo ===== -->
    <DataTemplate DataType="{x:Type linhas:LinhaEmprestimo}">
        <Grid Margin="4,4,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                    Background="{DynamicResource BrushAccentSoft}" Padding="7">
                <Image Source="Assets/icons/emprestimo.png" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DataTexto}" Style="{StaticResource TextoSecundario}" Margin="0,2,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding Valor}" VerticalAlignment="Center"
                       FontSize="13" FontWeight="Bold" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
